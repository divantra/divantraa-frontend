# ── Backend (server-side only — never exposed to the browser) ──────────────
# Used by Next.js SSR/server-components when calling the Express backend.
# No NEXT_PUBLIC_ prefix → stays out of the client bundle.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_st_xxxxxxxxxxxx
NEXT_PUBLIC_IMAGE_URL=https://divantraa.com/images/

# Payment UI: "hosted" (default) = Pay securely opens Cashfree's page with every payment option;
# "custom" = our in-page checkout (inline QR, UPI ID/apps, netbanking, wallets) kept as a fallback.
NEXT_PUBLIC_PAYMENT_UI=hosted
